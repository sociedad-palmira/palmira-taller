rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquiera que escanee el QR de una etiqueta puede ver el mueble en 3D (solo leer ese proyecto, no la lista)
    match /proyectos/{pid} {
      allow get: if true;
    }
    // Todo lo demás: solo los usuarios del taller (con correo y clave)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
